{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "port": 8080,
  "timeout": "3s",
  "cache_ttl": "5m",
  "name": "My Awesome API Gateway",
  "endpoints": [
    {
      "endpoint": "/v1/users/{id}",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/users/{id}",
          "encoding": "json",
          "host": [
            "http://user-service.internal:8081"
          ]
        }
      ]
    },
    {
      "endpoint": "/v1/dashboard/{id}",
      "method": "GET",
      "output_encoding": "json",
      "comment": "Aggregates profile and order history into a single response.",
      "backend": [
        {
          "url_pattern": "/users/{id}",
          "allow": [
            "id",
            "username",
            "email"
          ],
          "host": [
            "http://user-service.internal:8081"
          ]
        },
        {
          "url_pattern": "/orders?userId={id}",
          "mapping": {
            "collection": "recent_orders"
          },
          "host": [
            "http://order-service.internal:8082"
          ]
        }
      ]
    }
  ]
}