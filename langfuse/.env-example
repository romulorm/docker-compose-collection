# ============================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env-example .env
#   2. Preencha os valores reais
#   3. NUNCA commite o arquivo .env no git
#   4. Adicione .env no .gitignore

# --- Credenciais principais (CHANGEME) ---
NEXTAUTH_SECRET=SALT=gere-com(openssl rand -hex 32)
NEXTAUTH_URL=http://localhost:3000
SALT=gere-com(openssl rand -hex 16)
ENCRYPTION_KEY=SALT=gere-com(openssl rand -hex 32)

# --- Banco de dados ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
POSTGRES_VERSION=17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# --- ClickHouse ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# --- MinIO (S3) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=miniosecret
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=miniosecret
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=miniosecret

# --- Redis ---
REDIS_AUTH=myredissecret
